rule "Diagnosis: Wax Moth (accumulate count >= 4)"
    salience 85
when
    DiseaseSuspicion( disease == "WaxMoth" )
    Number( intValue >= 4 ) from accumulate(
        Symptom(
            name == "moth_larvae_on_comb" ||
            name == "tunnels_webbing" ||
            name == "damaged_comb" ||
            name == "weak_colony_under_5" ||
            name == "poor_comb_storage"
        ),
