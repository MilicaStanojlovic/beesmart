rule "Diagnosis: CCD (1 specific + 2 general)"
    salience 85
when
    Number( intValue >= 1 ) from accumulate(
        Symptom(
            specific == true,
            name == "sudden_disappearance" ||
            name == "treated_with_pesticides" ||
            name == "varroa_history_6m"
        ),
        count(1)
    )
    Number( intValue >= 2 ) from accumulate(
        Symptom(
            specific == false,
            name == "untouched_stores" ||
            name == "no_dead_bees" ||
            name == "brood_without_bees"
        ),
        count(1)
    )
    not Diagnosis( disease == "CCD" )
then
    insert(new Diagnosis("CCD", "URGENT", true));
    System.out.println("[LEVEL2] DIAGNOSIS: CCD (Colony Collapse Disorder) - URGENT");
end

rule "Diagnosis: Weakening Syndrome (1 specific + 2 general)"
    salience 84
when
    Number( intValue >= 1 ) from accumulate(
        Symptom(
            specific == true,
            name == "gradual_population_decline" ||
            name == "varroa_nosema_history_6m" ||
            name == "antibiotics_60d"
        ),
        count(1)
    )
    Number( intValue >= 2 ) from accumulate(
        Symptom(
            specific == false,
            name == "reduced_egg_laying" ||
            name == "weak_brood" ||
            name == "reduced_nectar_intake"
        ),
        count(1)
    )
    not Diagnosis( disease == "CCD" )
    not Diagnosis( disease == "WeakeningSyndrome" )
then
    insert(new Diagnosis("WeakeningSyndrome", "HIGH", true));
    System.out.println("[LEVEL2] DIAGNOSIS: Weakening Syndrome - HIGH");
end