package rules.forward;

import com.beesmart.model.*;

// ─────────────────────────────────
// DIAGNOSIS RULES
// ─────────────────────────────────

rule "Diagnosis: Varroosis (all symptoms)"
    salience 85
when
    DWVMarker( detected == true )
    InfestationLevel( level == "high" )
    Symptom( name == "visible_mites" )
    Symptom( name == "reduced_population" )
    not Diagnosis( disease == "Varroosis" )
then
    insert(new Diagnosis("Varroosis", "URGENT", true));
    System.out.println("[LEVEL2] DIAGNOSIS: Varroosis - ALL symptoms met - URGENT");
end

rule "Diagnosis: Nosemosis (all symptoms)"
    salience 85
when
    DiseaseSuspicion( disease == "Nosemosis" )
    Symptom( name == "spring_mortality" )
    Symptom( name == "weak_spring_development" )
    not Diagnosis( disease == "Nosemosis" )
then
    insert(new Diagnosis("Nosemosis", "HIGH", true));
    System.out.println("[LEVEL2] DIAGNOSIS: Nosemosis - ALL symptoms met - HIGH");
end

rule "Diagnosis: American Foulbrood (accumulate count >= 4)"
    salience 85
when
    DiseaseSuspicion( disease == "AmericanFoulbrood" )
    Number( intValue >= 4 ) from accumulate(
        Symptom(
            name == "ropiness_test_positive" ||
            name == "smell_of_decay" ||
            name == "mosaic_brood" ||
            name == "sunken_cappings" ||
            name == "dark_sticky_larvae" ||
            name == "reduced_population"
        ),
        count(1)
    )
    not Diagnosis( disease == "AmericanFoulbrood" )
then
    insert(new Diagnosis("AmericanFoulbrood", "URGENT", true));
    System.out.println("[LEVEL2] DIAGNOSIS: American Foulbrood (>=4 symptoms) - URGENT");
end

