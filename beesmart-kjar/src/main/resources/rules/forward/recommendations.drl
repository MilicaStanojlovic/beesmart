    r.setType("TREATMENT");
    r.setHiveId($h.getId());
    r.setCheckInDays(14);
    insert(r);
    System.out.println("[LEVEL3] Treatment: Chalkbrood");
end

rule "Treatment: Wax Moth"
    salience 60
when
    Diagnosis( disease == "WaxMoth" )
    $h : Hive()
    not Recommendation( type == "TREATMENT", hiveId == $h.id )
then
    Recommendation r = new Recommendation(
        "Strengthen colony. Remove damaged comb. Treat stored comb with sulfur dioxide. " +
        "Store comb in cold, well-ventilated area.", "MEDIUM");
    r.setType("TREATMENT");
    r.setHiveId($h.getId());
    r.setCheckInDays(14);
    insert(r);
    System.out.println("[LEVEL3] Treatment: Wax Moth");
end

rule "Treatment: Nosemosis"
    salience 75
when
    Diagnosis( disease == "Nosemosis" )
    $h : Hive()
    not Recommendation( type == "TREATMENT", hiveId == $h.id )
then
    Recommendation r = new Recommendation(
        "Feed with syrup enriched with thymol. Replace old combs. " +
        "Ensure good ventilation. Consider lab analysis to confirm.", "HIGH");
    r.setType("TREATMENT");
    r.setHiveId($h.getId());
    r.setCheckInDays(14);
    insert(r);
    System.out.println("[LEVEL3] Treatment: Nosemosis");
end

rule "Treatment: CCD"
    salience 90
when
    Diagnosis( disease == "CCD" )
    $h : Hive()
    not Recommendation( type == "TREATMENT", hiveId == $h.id )
then
    Recommendation r = new Recommendation(
        "Eliminate pesticide exposure. Strengthen colony with nurse bees from healthy hive. " +
        "Replace queen. Monitor closely for 30 days.", "URGENT");
    r.setType("TREATMENT");
    r.setHiveId($h.getId());
    r.setCheckInDays(7);
    insert(r);
    System.out.println("[LEVEL3] Treatment: CCD - URGENT");
end

rule "Treatment: Weakening Syndrome"
    salience 75
when
    Diagnosis( disease == "WeakeningSyndrome" )
    $h : Hive()
    not Recommendation( type == "TREATMENT", hiveId == $h.id )
then
    Recommendation r = new Recommendation(
        "Treat underlying disease first (varroa/nosema). Feed supplemental protein patty. " +
        "Consider merging with strong colony if unresponsive in 14 days.", "HIGH");
    r.setType("TREATMENT");
    r.setHiveId($h.getId());
    r.setCheckInDays(14);
    insert(r);
    System.out.println("[LEVEL3] Treatment: Weakening Syndrome");
end
